generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model AyahRef {
  surah       Int
  ayah        Int
  page        Int
  juz         Int
  letterCount Int

  @@id([surah, ayah])
  @@index([page])
}
