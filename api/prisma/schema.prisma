generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model AyahRef {
  surah       Int
  ayah        Int
  page        Int
  juz         Int
  letterCount Int

  @@id([surah, ayah])
  @@index([page])
}

model Bookmark {
  userId    String   @id
  surah     Int
  ayah      Int
  page      Int
  updatedAt DateTime @updatedAt
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  surah     Int
  ayah      Int
  createdAt DateTime @default(now())

  @@unique([userId, surah, ayah])
  @@index([userId])
}
