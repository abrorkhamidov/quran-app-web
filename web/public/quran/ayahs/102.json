[{"surah":102,"ayah":1,"text":" أَلْهَىٰكُمُ ٱلتَّكَاثُرُ","translation":"Competition in [worldly] increase diverts you"},{"surah":102,"ayah":2,"text":"حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ","translation":"Until you visit the graveyards.1"},{"surah":102,"ayah":3,"text":"كَلَّا سَوْفَ تَعْلَمُونَ","translation":"No! You are going to know."},{"surah":102,"ayah":4,"text":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ","translation":"Then, no! You are going to know."},{"surah":102,"ayah":5,"text":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ","translation":"No! If you only knew with knowledge of certainty...1"},{"surah":102,"ayah":6,"text":"لَتَرَوُنَّ ٱلْجَحِيمَ","translation":"You will surely see the Hellfire."},{"surah":102,"ayah":7,"text":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ","translation":"Then you will surely see it with the eye of certainty.1"},{"surah":102,"ayah":8,"text":"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ","translation":"Then you will surely be asked that Day about pleasure.1"}]