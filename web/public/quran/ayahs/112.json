[{"surah":112,"ayah":1,"text":" قُلْ هُوَ ٱللَّهُ أَحَدٌ","translation":"Say, \"He is Allāh, [who is] One,"},{"surah":112,"ayah":2,"text":"ٱللَّهُ ٱلصَّمَدُ","translation":"Allāh, the Eternal Refuge."},{"surah":112,"ayah":3,"text":"لَمْ يَلِدْ وَلَمْ يُولَدْ","translation":"He neither begets nor is born,"},{"surah":112,"ayah":4,"text":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","translation":"Nor is there to Him any equivalent.\""}]