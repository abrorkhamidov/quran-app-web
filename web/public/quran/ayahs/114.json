[{"surah":114,"ayah":1,"text":" قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ","translation":"Say, \"I seek refuge in the Lord of mankind,"},{"surah":114,"ayah":2,"text":"مَلِكِ ٱلنَّاسِ","translation":"The Sovereign of mankind,"},{"surah":114,"ayah":3,"text":"إِلَـٰهِ ٱلنَّاسِ","translation":"The God of mankind,"},{"surah":114,"ayah":4,"text":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ","translation":"From the evil of the retreating whisperer1 -"},{"surah":114,"ayah":5,"text":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ","translation":"Who whispers [evil] into the breasts of mankind -"},{"surah":114,"ayah":6,"text":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ","translation":"From among the jinn and mankind\".1"}]