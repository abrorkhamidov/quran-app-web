[{"surah":96,"ayah":1,"text":" ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ","translation":"Recite in the name of your Lord who created"},{"surah":96,"ayah":2,"text":"خَلَقَ ٱلْإِنسَـٰنَ مِنْ عَلَقٍ","translation":"Created man from a clinging substance."},{"surah":96,"ayah":3,"text":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ","translation":"Recite, and your Lord is the most Generous -"},{"surah":96,"ayah":4,"text":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ","translation":"Who taught by the pen"},{"surah":96,"ayah":5,"text":"عَلَّمَ ٱلْإِنسَـٰنَ مَا لَمْ يَعْلَمْ","translation":"Taught man that which he knew not."},{"surah":96,"ayah":6,"text":"كَلَّآ إِنَّ ٱلْإِنسَـٰنَ لَيَطْغَىٰٓ","translation":"No! [But] indeed, man transgresses"},{"surah":96,"ayah":7,"text":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ","translation":"Because he sees himself self-sufficient."},{"surah":96,"ayah":8,"text":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ","translation":"Indeed, to your Lord is the return."},{"surah":96,"ayah":9,"text":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ","translation":"Have you seen the one who forbids"},{"surah":96,"ayah":10,"text":"عَبْدًا إِذَا صَلَّىٰٓ","translation":"A servant when he prays?"},{"surah":96,"ayah":11,"text":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ","translation":"Have you seen if he is upon guidance"},{"surah":96,"ayah":12,"text":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ","translation":"Or enjoins righteousness?"},{"surah":96,"ayah":13,"text":"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","translation":"Have you seen if he denies and turns away -"},{"surah":96,"ayah":14,"text":"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ","translation":"Does he not know that Allāh sees?"},{"surah":96,"ayah":15,"text":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ","translation":"No! If he does not desist, We will surely drag him by the forelock1"},{"surah":96,"ayah":16,"text":"نَاصِيَةٍ كَـٰذِبَةٍ خَاطِئَةٍ","translation":"A lying, sinning forelock."},{"surah":96,"ayah":17,"text":"فَلْيَدْعُ نَادِيَهُۥ","translation":"Then let him call his associates;"},{"surah":96,"ayah":18,"text":"سَنَدْعُ ٱلزَّبَانِيَةَ","translation":"We will call the angels of Hell.1"},{"surah":96,"ayah":19,"text":"كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩","translation":"No! Do not obey him. But prostrate and draw near [to Allāh]."}]